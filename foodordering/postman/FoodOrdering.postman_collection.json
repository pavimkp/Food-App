            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/restaurants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Napoli Slice\",\n  \"description\": \"Wood-fired pizzas and Italian classics.\",\n  \"address\": \"14 Northern Quarter, Manchester\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1513104890138-7c749659a591?w=800\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function(){ pm.response.to.have.status(201); });",
